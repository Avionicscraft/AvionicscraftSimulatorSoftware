// =====================================================
// W5500 reset
// =====================================================

void resetW5500() {

  pinMode(W5500_RST, OUTPUT);

  digitalWrite(W5500_RST, LOW);

  delay(300);

  digitalWrite(W5500_RST, HIGH);

  delay(1000);
}

// =====================================================
// Ethernet starten
// =====================================================

void startEthernet() {

  SPI.begin(
    W5500_SCK,
    W5500_MISO,
    W5500_MOSI,
    W5500_CS
  );

  SPI.setFrequency(8000000);

  Ethernet.init(W5500_CS);

  Ethernet.begin(mac, localIp);

  delay(1000);

  ethernetOk = true;
}

// =====================================================
// TCP verbinding
// =====================================================

void connectToServer() {

  if (!ethernetOk) return;

  if (Ethernet.linkStatus() == LinkOFF) {

    client.stop();

    return;
  }

  if (client.connected()) return;

  client.stop();

  client.setTimeout(50);

  if (client.connect(serverIp, serverPort)) {

    lastPacketTime = millis();
  }
}

// =====================================================
// Setup
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  // ===================================================
  // PWM
  // ===================================================

  ledcAttach(LED_PIN, pwmFreq, pwmResolution);

  ledcWrite(LED_PIN, 0);

  // ===================================================
  // Reset W5500
  // ===================================================

  resetW5500();

  // ===================================================
  // Ethernet starten
  // ===================================================

  startEthernet();

  // ===================================================
  // Verbinden met DCS-BIOS server
  // ===================================================

  connectToServer();
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  // ===================================================
  // Ethernet link check
  // ===================================================

  if (Ethernet.linkStatus() == LinkOFF) {

    client.stop();

    delay(100);

    return;
  }

  // ===================================================
  // Reconnect handling
  // ===================================================

  if (!client.connected()) {

    unsigned long now = millis();

    if (now - lastReconnectAttempt > 3000) {

      lastReconnectAttempt = now;

      connectToServer();
    }

  } else {

    // =================================================
    // TCP data lezen
    // =================================================

    int limit = 256;

    while (client.available() && limit--) {

      int c = client.read();

      if (c < 0) {
        break;
      }

      parser.processChar((char)c);

      lastPacketTime = millis();

      delayMicroseconds(20);
    }

    // ================================================
    // Socket timeout detectie
    // ================================================

    if (millis() - lastPacketTime > 10000) {

      client.stop();
    }
  }

  // ===================================================
  // DCS-BIOS processing
  // ===================================================

  DcsBios::PollingInput::pollInputs();

  DcsBios::ExportStreamListener::loopAll();

  // ===================================================
  // Yield
  // ===================================================

  delay(1);
}
