// DCS-BIOS F-16C
// ESP32-S3 Waveshare ETH PoE + W5500
// =====================================================

#include <SPI.h>
#include <Ethernet.h>

// =====================================================
// Forward declare voor DcsBios
// =====================================================

namespace DcsBios {
  bool tryToSendDcsBiosMessage(const char* msg, const char* arg);
}

#include <DcsBios.h>

// =====================================================
// W5500 pinnen
// =====================================================

#define W5500_CS    14
#define W5500_SCK   13
#define W5500_MISO  12
#define W5500_MOSI  11
#define W5500_RST   9

// =====================================================
// PWM LED
// =====================================================

#define LED_PIN 43

const int pwmFreq = 5000;
const int pwmResolution = 8;

// =====================================================
// Netwerk
// =====================================================

byte mac[] = {
  0x02, 0x68, 0x0B, 0x5D, 0xE3, 0xA4
};

IPAddress localIp(10, 10, 10, 37);
IPAddress serverIp(10, 10, 10, 1);
IPAddress subnet(255, 255, 255, 128);

const uint16_t serverPort = 7778;

// =====================================================
// Ethernet client
// =====================================================

EthernetClient client;

DcsBios::ProtocolParser parser;

// =====================================================
// Status variabelen
// =====================================================

unsigned long lastReconnectAttempt = 0;
unsigned long lastPacketTime = 0;

bool ethernetOk = false;

// =====================================================
// DCS-BIOS send functie
// =====================================================

namespace DcsBios {

  bool tryToSendDcsBiosMessage(const char* msg, const char* arg) {

    if (!client.connected()) {
      return false;
    }

    size_t n = client.print(msg);

    if (n == 0) {
      client.stop();
      return false;
    }

    client.print(' ');
    client.print(arg);
    client.print('\n');

    return true;
  }
}

// =====================================================
// PWM brightness callback
// =====================================================

void onPriConsolesBrtKnbChange(unsigned int newValue) {

  int pwmValue = map(newValue, 0, 65535, 0, 255);

  pwmValue = constrain(pwmValue, 0, 255);

  ledcWrite(LED_PIN, pwmValue);
}

